# ModelCheck local configuration
# Run from the project directory: cp -n .env.example .env
# Local credentials belong in the ignored .env file.

# Required for live AI reviews and evaluations. Leave blank for tools-only/replay mode.
# API keys: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional model overrides. These match the application's defaults.
# The application only permits verified free models with tool support.
MODELCHECK_MODEL=nvidia/nemotron-3.5-lightning:free

# Demo fallback only; A/B evaluations keep the selected model fixed.
MODELCHECK_FALLBACK=thinkingmachines/inkling-small:free

# Optional storage override. Omit to use the project's runtime/ directory.
# Use an absolute path outside your public source files.
# MODELCHECK_RUNTIME=/absolute/path/to/modelcheck-runtime

